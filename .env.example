# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY=

# APP_URL: The public URL where this applet is hosted.
APP_URL=

# Admin Panel protection passcode (server-side only; if blank, first-run Admin Setup UI activates)
ADMIN_PASSWORD=

# Optional Google reCAPTCHA v2/v3 keys (built-in server verification captcha runs when blank)
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=

# Optional Firebase client configuration (for Firebase hosting/deployment)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
